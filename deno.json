{
  "name": "@earlytexts/markit",
  "version": "3.5.0",
  "license": "MIT",
  "exports": { ".": "./src/index.ts" },
  "publish": {
    "include": [
      "src/",
      "README.md",
      "SPECIFICATION.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0"
  },
  "tasks": {
    "test": "deno test test/ && deno task check",
    "test:watch": "deno test --watch test/",
    "test:coverage": "deno test --coverage test/ && deno coverage",
    "check": "deno check src/ test/ && deno lint && deno fmt --check"
  },
  "fmt": {
    "exclude": ["*.md"]
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["vscode-markit/"]
}
