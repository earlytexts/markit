{
  "name": "@earlytexts/markit",
  "version": "3.7.0",
  "license": "MIT",
  "exports": { ".": "./src/index.ts" },
  "publish": {
    "include": [
      "src/",
      "README.md",
      "SPECIFICATION.md",
      "LICENSE.md",
      "deno.json"
    ]
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0"
  },
  "tasks": {
    "test": "deno test test/",
    "test:coverage": "deno test --coverage test/ && deno coverage",
    "bench": "deno bench bench/",
    "check": "deno check src/ test/ bench/ && deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "fmt": {
    "exclude": ["*.md"]
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["vscode-markit/"]
}
