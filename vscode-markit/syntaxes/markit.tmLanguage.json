{
  "scopeName": "source.markit",
  "name": "Markit",
  "patterns": [
    { "include": "#id" },
    { "include": "#metadataBlock" },
    { "include": "#blockTag" },
    { "include": "#headingLine" },
    { "include": "#blockquoteLine" },
    { "include": "#inline" }
  ],
  "repository": {
    "id": {
      "match": "^((#{1,6})\\s+(.+))$",
      "captures": {
        "1": { "name": "markup.heading.markit" },
        "2": { "name": "punctuation.definition.heading.markit" },
        "3": { "name": "entity.name.section.markit" }
      }
    },
    "metadataBlock": {
      "begin": "^\\[metadata(?:\\.\\w+)?\\]\\s*$",
      "end": "^(?=\\s*$|\\s*\\{#|\\s*\\[metadata)",
      "name": "meta.block.metadata.markit",
      "beginCaptures": {
        "0": { "name": "keyword.other.metadata-header.markit" }
      },
      "patterns": [
        {
          "match": "^(\\w+)\\s*(=)",
          "captures": {
            "1": { "name": "entity.name.tag.markit" },
            "2": { "name": "punctuation.separator.key-value.markit" }
          }
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.markit"
        },
        {
          "match": "\\b-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.markit"
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.markit"
        },
        {
          "match": "[\\[\\],]",
          "name": "punctuation.definition.array.markit"
        }
      ]
    },
    "blockTag": {
      "begin": "(\\{)(#)([a-zA-Z0-9.]+)",
      "end": "(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.block-tag.begin.markit" },
        "2": { "name": "entity.name.tag.block-tag.hash.markit" },
        "3": { "name": "constant.character.block-tag.id.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.block-tag.end.markit" }
      },
      "name": "meta.block-tag.markit",
      "patterns": [
        {
          "match": "(\\w+)\\s*(=)",
          "captures": {
            "1": { "name": "entity.name.tag.markit" },
            "2": { "name": "punctuation.separator.key-value.markit" }
          }
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.markit"
        },
        {
          "match": "\\b-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.markit"
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.markit"
        },
        {
          "match": "[\\[\\],]",
          "name": "punctuation.definition.array.markit"
        }
      ]
    },
    "headingLine": {
      "match": "^(\\^[1-6])\\s+(.*)",
      "captures": {
        "1": { "name": "punctuation.definition.heading.markit" },
        "2": { "name": "markup.bold.markit" }
      },
      "name": "markup.bold.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "blockquoteLine": {
      "match": "^(>)\\s?(.*)",
      "captures": {
        "1": { "name": "punctuation.definition.quote.begin.markit" },
        "2": { "name": "markup.quote.block.content.markit" }
      },
      "name": "string.quoted.double.block.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "inline": {
      "patterns": [
        { "include": "#quote" },
        { "include": "#strong" },
        { "include": "#emphasis" },
        { "include": "#foreign" },
        { "include": "#aside" },
        { "include": "#speaker" },
        { "include": "#person" },
        { "include": "#place" },
        { "include": "#insertion" },
        { "include": "#deletion" },
        { "include": "#highlight" },
        { "include": "#illegible" },
        { "include": "#uncertain" },
        { "include": "#citation" },
        { "include": "#emSpace" },
        { "include": "#nbSpace" },
        { "include": "#lineBreak" },
        { "include": "#pageBreakRef" },
        { "include": "#pageBreakEmpty" },
        { "include": "#greekMode" },
        { "include": "#characterMode" },
        { "include": "#footnoteRef" },
        { "include": "#escape" }
      ]
    },
    "quote": {
      "begin": "(?<!\\\\)(\")",
      "end": "(?<!\\\\)(\")",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.quote.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.quote.end.markit" }
      },
      "name": "string.quoted.double.inline.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "strong": {
      "begin": "(?<!\\\\)(\\*)",
      "end": "(?<!\\\\)(\\*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.bold.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.bold.end.markit" }
      },
      "name": "markup.bold.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "emphasis": {
      "begin": "(?<!\\\\)(_)",
      "end": "(?<!\\\\)(_)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.italic.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.italic.end.markit" }
      },
      "name": "markup.italic.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "foreign": {
      "begin": "(?<!\\\\)(\\$(?:[a-z]{2,3}:)?)",
      "end": "(?<!\\\\)(\\$)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.italic.foreign.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.italic.foreign.end.markit" }
      },
      "name": "markup.italic.foreign.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "aside": {
      "begin": "(?<!\\\\)(@)",
      "end": "(?<!\\\\)(@)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.comment.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.comment.end.markit" }
      },
      "name": "comment.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "speaker": {
      "begin": "(?<!\\\\)(%)",
      "end": "(?<!\\\\)(%)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.speaker.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.speaker.end.markit" }
      },
      "name": "markup.other.speaker.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "person": {
      "begin": "(!person)(\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.person.markit" },
        "2": { "name": "punctuation.definition.person.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.person.end.markit" }
      },
      "name": "markup.other.person.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "place": {
      "begin": "(!place)(\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.place.markit" },
        "2": { "name": "punctuation.definition.place.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.place.end.markit" }
      },
      "name": "markup.other.place.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "insertion": {
      "begin": "(?<!\\\\)(\\+\\+)",
      "end": "(?<!\\\\)(\\+\\+)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.inserted.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.inserted.end.markit" }
      },
      "name": "markup.inserted.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "deletion": {
      "begin": "(?<!\\\\)(--)",
      "end": "(?<!\\\\)(--)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.deleted.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.deleted.end.markit" }
      },
      "name": "markup.deleted.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "illegible": {
      "match": "\\?\\?\\?",
      "name": "constant.character.illegible.markit"
    },
    "uncertain": {
      "begin": "(?<!\\\\)(\\?\\?)",
      "end": "(?<!\\\\)(\\?\\?)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.uncertain.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.uncertain.end.markit" }
      },
      "name": "markup.uncertain.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "highlight": {
      "begin": "(?<!\\\\)(==)",
      "end": "(?<!\\\\)(==)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.highlight.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.highlight.end.markit" }
      },
      "name": "markup.changed.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "citation": {
      "begin": "(?<!\\\\)(\\[)",
      "end": "(?<!\\\\)(\\])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.citation.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.citation.end.markit" }
      },
      "name": "markup.other.citation.markit",
      "patterns": [{ "include": "#inline" }]
    },
    "emSpace": {
      "match": "~~",
      "name": "constant.character.emspace.markit"
    },
    "nbSpace": {
      "match": "~",
      "name": "constant.character.nbsp.markit"
    },
    "lineBreak": {
      "match": "//",
      "name": "constant.character.linebreak.markit"
    },
    "pageBreakRef": {
      "match": "(\\|)([^\\s|]+)(\\|)",
      "captures": {
        "1": { "name": "punctuation.definition.pagebreak.begin.markit" },
        "2": { "name": "entity.name.section.pagebreak.markit" },
        "3": { "name": "punctuation.definition.pagebreak.end.markit" }
      }
    },
    "pageBreakEmpty": {
      "match": "\\|\\|",
      "name": "constant.character.pagebreak.markit"
    },
    "greekMode": {
      "begin": "(\\{\\{)",
      "end": "(\\}\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.greek-mode.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.greek-mode.end.markit" }
      },
      "name": "meta.greek-mode.markit",
      "patterns": [
        {
          "match": "[Tt][Hh]|[Pp][Hh]|[Cc][Hh]|[Pp][Ss]",
          "name": "constant.character.digraph.markit"
        },
        {
          "match": "[)(/'`^\"\\|]",
          "name": "constant.character.diacritic.markit"
        },
        {
          "match": "\\\\[)(/'`^\"\\|\\\\]",
          "name": "constant.character.escape.markit"
        }
      ]
    },
    "characterMode": {
      "begin": "(?<!\\\\)(\\{)(?!\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.character-mode.begin.markit" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.character-mode.end.markit" }
      },
      "name": "meta.character-mode.markit",
      "patterns": [
        {
          "match": "--",
          "name": "constant.character.em-dash.markit"
        },
        {
          "match": "AE|ae|OE|oe|[cC],",
          "name": "constant.character.digraph.markit"
        },
        {
          "match": "-",
          "name": "constant.character.en-dash.markit"
        },
        {
          "match": "[/'`^\"$]",
          "name": "constant.character.diacritic.markit"
        },
        {
          "match": "\\\\[/'`^\"$\\-\\\\]",
          "name": "constant.character.escape.markit"
        }
      ]
    },
    "footnoteRef": {
      "match": "(<)(n[^\\s#{}]+)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.footnote.begin.markit" },
        "2": { "name": "entity.name.citation.markit" },
        "3": { "name": "punctuation.definition.footnote.end.markit" }
      }
    },
    "escape": {
      "match": "\\\\[\\\\*_\"$@%+\\-=<>\\[\\]{}£~|/#]",
      "name": "constant.character.escape.markit"
    }
  }
}
